<glassfish-web-app xmlns="http://glassfish.org/schema/glassfish-web-app" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                   xsi:schemaLocation="http://glassfish.org/schema/glassfish-web-app http://glassfish.org/schema/glassfish-web-app/glassfish-web-app_3_0-1.xsd">
  <class-loader delegate="false"/>
  <jsp-config>
    <property name="keepgenerated" value="true">
      <description>Keep a copy of the generated servlet class' java code.</description>
    </property>
  </jsp-config>
</glassfish-web-app>
